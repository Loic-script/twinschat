DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/twinslack
# Dossier des fichiers envoyés (pièces jointes, photos). Créé automatiquement et vérifié au démarrage.
# En production : chemin ABSOLU sur un disque persistant de l'hébergeur, hors du dossier de l'application
# (sinon il peut être effacé à chaque redéploiement), ex. UPLOAD_DIR=/var/lib/twinschat/uploads.
# À sauvegarder avec la base de données. Hébergements sans disque permanent (Vercel, Netlify…) : non adaptés.
UPLOAD_DIR=storage/uploads

# Identifiants du compte administrateur (appliqués en base par : npm run db:admin)
ADMIN_EMAIL=admin@twinslack.app
ADMIN_PASSWORD=

# Connexion avec Google (Google Cloud Console > API et services > Identifiants > ID client OAuth « Application Web »)
# URI de redirection autorisée à déclarer : http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif : à renseigner si l'adresse publique diffère de celle vue par le serveur
# GOOGLE_REDIRECT_URI=https://votre-domaine/api/auth/google/callback

# Mot de passe des comptes de démo créés par npm run db:seed / db:profiles (facultatif)
DEMO_PASSWORD=


# Traduction des messages par l IA Mistral (clé gratuite : console.mistral.ai > API Keys).
# Sans clé, la traduction est faite par le navigateur (Chrome sur ordinateur).
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_FALLBACK_MODEL=ministral-8b-latest

# Adresse publique du site (sitemap.xml, robots.txt). En production : https://votre-domaine
SITE_URL=http://localhost:3000

# Notifications push (Web Push). Générer les clés : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact du responsable (mailto:vous@domaine ou https://votre-site), transmis aux services de notification
VAPID_SUBJECT=
