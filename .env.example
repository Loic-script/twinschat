DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/twinslack
UPLOAD_DIR=storage/uploads

# Identifiants du compte administrateur (appliqués en base par : npm run db:admin)
ADMIN_EMAIL=admin@twinslack.app
ADMIN_PASSWORD=

# Connexion avec Google (Google Cloud Console > API et services > Identifiants > ID client OAuth « Application Web »)
# URI de redirection autorisée à déclarer : http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif : à renseigner si l'adresse publique diffère de celle vue par le serveur
# GOOGLE_REDIRECT_URI=https://votre-domaine/api/auth/google/callback

# Mot de passe des comptes de démo créés par npm run db:seed / db:profiles (facultatif)
DEMO_PASSWORD=
